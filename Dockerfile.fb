FROM python:3.12-slim

# Camoufox needs a handful of X/GTK libs to launch its patched Firefox headless.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgtk-3-0 libx11-xcb1 libasound2 libdbus-glib-1-2 libxtst6 \
    libxrandr2 libgbm1 fonts-liberation ca-certificates wget \
    libxcomposite1 libxdamage1 libxfixes3 libxi6 libxcursor1 \
    libpci3 libegl1 \
 && rm -rf /var/lib/apt/lists/*

# Railway's container runtime blocks the unprivileged user namespaces
# Firefox's process sandbox needs, so the content process dies on the first
# navigation ("Page.goto: Page crashed"). The browser is single-purpose and
# containerised — turn the inner sandboxes off.
ENV MOZ_DISABLE_CONTENT_SANDBOX=1 \
    MOZ_DISABLE_GMP_SANDBOX=1 \
    MOZ_DISABLE_RDD_SANDBOX=1 \
    MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1

RUN pip install --no-cache-dir "camoufox[geoip]" requests

# download the patched Firefox binary at build time so boot is fast
RUN python -m camoufox fetch

COPY fb_service.py /app/fb_service.py
WORKDIR /app
CMD ["python", "fb_service.py"]
